# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real API keys.
#
# This is one of several ways to get a key to REXO — session/shell-level,
# and only takes effect from whichever directory has this .env in it. For
# persistent, workspace-independent credentials, prefer `/connect` (or
# `/api set --permanent`) instead, which save to REXO's global credential
# store — see README's "Configuration, providers, and credentials" section.

# --- NVIDIA NIM (provider = "nvidia") ---
NVIDIA_API_KEY=your-nvidia-api-key-here

# --- Generic OpenAI-compatible endpoint (provider = "openai_compatible") ---
# OPENAI_API_KEY=your-api-key-here

# --- Local model server (provider = "local", e.g. Ollama) ---
# Usually no key needed; uncomment if your local server requires one.
# LOCAL_API_KEY=

# --- Any provider profile saved via /connect, by its credential key ---
# REXO_<CREDENTIAL_KEY>_API_KEY=your-key-here   # e.g. REXO_OPENROUTER_API_KEY

# Optional overrides — these take precedence over rexo.toml and your
# global default provider if set:
# REXO_PROVIDER=nvidia
# REXO_MODEL=moonshotai/kimi-k3
# REXO_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Advanced: override where REXO's global config/credentials directory
# lives (defaults to an OS-appropriate per-user directory).
# REXO_GLOBAL_DIR=
